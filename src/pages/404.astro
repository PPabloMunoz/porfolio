---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Not Found">
	<main class="flex flex-col justify-center min-h-[60vh] gap-8 animate-fade-in">
		<div class="space-y-2">
			<div class="flex items-center gap-2 text-red-500 text-sm">
				<span class="animate-pulse">❯</span>
				<span>error_status</span>
			</div>
			<h1 class="text-6xl md:text-8xl font-bold text-white tracking-tighter">
				404
			</h1>
		</div>

		<div class="space-y-2">
			<div class="flex items-center gap-2 text-cyan-400 text-sm">
				<span>❯</span>
				<span>message</span>
			</div>
			<p class="text-zinc-400 text-lg">
				The requested route was not found in this server.
			</p>
		</div>

		<div class="pt-8">
			<a href="/" class="group flex items-center gap-2 text-white hover:text-cyan-400 transition-colors">
				<span class="text-cyan-400 group-hover:translate-x-1 transition-transform">❯</span>
				<span class="underline underline-offset-4 decoration-zinc-700 group-hover:decoration-cyan-400">cd /home</span>
			</a>
		</div>
	</main>
</Layout>
