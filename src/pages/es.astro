---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Skills from '../components/Skills.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { content, getProjects } from '../data/portfolio';

const data = content.es;
const projects = getProjects('es');
const total = String(projects.length).padStart(2, '0');
---

<Layout lang="es">
	<Hero bioParagraphs={data.hero.bioParagraphs} lang="es" />

	<Section id="skills">
		<Skills introText={data.skills.intro} categories={data.skills.categories} />
	</Section>

	<Section id="projects">
		<div class="space-y-3 mb-8">
			<p class="text-sm text-[var(--color-accent)]">$ projects</p>
			<h2 class="font-bold text-[var(--color-ink)] text-[var(--text-xl)] tracking-tight min-w-0" style="font-family: var(--font-display); overflow-wrap: anywhere;">{data.projects.title}</h2>
			<p class="tnum text-xs text-[var(--color-ink-2)]">Selected work · {projects.length} repos · Go-first</p>
		</div>

		<div class="grid gap-[var(--space-lg)]" style="grid-template-columns: minmax(0, 1fr);">
			{projects.map((project, i) => (
				<ProjectCard
					title={project.title}
					description={project.description}
					tech={project.tech}
					link={project.link}
					index={`${String(i + 1).padStart(2, '0')} / ${total}`}
				/>
			))}

			<div class="tnum border border-dashed border-[var(--color-rule)] p-6 flex items-center justify-center gap-3 text-[var(--color-ink-2)]">
				<span aria-hidden="true" class="opacity-60">+</span>
				<span class="text-sm">{data.projects.footer}</span>
			</div>
		</div>
	</Section>

	<footer class="tnum border-t border-[var(--color-rule)] pt-6 text-xs leading-relaxed text-[var(--color-ink-2)]">
		<p>&copy; {new Date().getFullYear()} Pablo Muñoz · {data.footer.createdWith} · Go · <a href="/" hreflang="en" class="whitespace-nowrap underline underline-offset-2 decoration-[var(--color-rule)] hover:text-[var(--color-accent)] hover:decoration-[var(--color-accent)] transition-colors duration-[var(--dur-micro)]">EN</a></p>
	</footer>
</Layout>
