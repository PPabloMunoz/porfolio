---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Skills from '../components/Skills.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { content, getProjects } from '../data/portfolio';

const data = content.es;
const projects = getProjects('es');
---

<Layout lang="es">
	<Hero bioParagraphs={data.hero.bioParagraphs} lang="es" />
	
	<Section>
		<Skills introText={data.skills.intro} categories={data.skills.categories} />
	</Section>

	<Section id="projects">
		<h2 class="text-xl font-bold flex items-center gap-2 mb-8">
			<span class="text-cyan-400">./</span>
			<span>{data.projects.title}</span>
		</h2>
		
		<div class="grid gap-6">
			{projects.map(project => (
				<ProjectCard 
					title={project.title}
					description={project.description}
					tech={project.tech}
					link={project.link}
				/>
			))}
			
			<div class="border border-zinc-800 border-dashed p-6 flex flex-col items-center justify-center text-zinc-500 gap-2">
				<span class="text-2xl opacity-50">+</span>
				<span class="text-sm">{data.projects.footer}</span>
			</div>
		</div>
	</Section>

	<footer class="text-xs text-zinc-600 pt-12 border-t border-zinc-900 flex justify-between">
		<span>&copy; {new Date().getFullYear()} Pablo Muñoz</span>
		<span class="hidden md:inline">{data.footer.createdWith}</span>
	</footer>
</Layout>
