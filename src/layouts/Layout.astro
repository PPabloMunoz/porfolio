---
import '@fontsource-variable/onest'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content='Pablo Muñoz portfolio' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --background-color: 0, 0%, 12.2%;
    --primary-foreground: 0, 0%, 88%;
    --secondary: 216, 100%, 63%;
    --card: 0, 0%, 14.9%;
  }

  ::selection {
    @apply bg-secondary text-background;
  }

  html {
    font-family: 'Onest Variable', system-ui, sans-serif;
    @apply scroll-smooth;
  }

  body {
    @apply bg-background text-primary-foreground;
  }
</style>
