---
import Title from '../title.astro'

type TProject = {
  name: string
  description: string
  image: string
  url: string
  tags: string[]
}

const projects: TProject[] = [
  {
    name: 'Vulture Brand E-Commerce',
    description: 'E-Commerce para la marca Vulture Brand',
    image: '/projects/vulture.webp',
    url: 'https://vulture.pablomunoz.dev',
    tags: ['Next.js', 'Tailwind CSS', 'TypeScript', 'Drizzle ORM', 'Stripe'],
  },
]
---

<section id='projects'>
  <Title title='Proyectos' />

  <div class='flex flex-col gap-4'>
    {
      projects.length > 0 &&
        projects.map((project) => (
          <div class='flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center border border-transparent hover:border-white/10 hover:bg-card rounded-xl p-4 transition-colors duration-300 shadow-md shadow-black/20'>
            <div class='flex flex-col gap-1'>
              <h3 class='text-2xl font-bold'>{project.name}</h3>
              <p class='text-sm font-light'>{project.description}</p>
              <div class='flex gap-2 flex-wrap mt-4 max-w-sm'>
                {project.tags.map((tag) => (
                  <span class='text-xs px-3 py-1 border border-white/10 rounded-full flex justify-center items-center'>
                    {tag}
                  </span>
                ))}
              </div>

              <a
                href={project.url}
                class='text-sm bg-secondary rounded-full px-3 py-1 w-fit mt-4 flex items-center gap-2 text-black font-medium'
              >
                <img
                  src='/icons/globe.svg'
                  alt='External link'
                  class='size-4'
                />
                Visitar
              </a>
            </div>

            <img
              src={project.image}
              alt={project.name}
              class='aspect-video sm:w-1/3 object-cover rounded-md w-full'
            />
          </div>
        ))
    }

    {
      projects.length === 0 && (
        <p class='text-center text-sm text-white/50'>Próximamente...</p>
      )
    }
  </div>
</section>
