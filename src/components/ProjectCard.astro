---
interface Props {
  title: string;
  description: string;
  tech: string[];
  link: string;
  index?: string;
}

const { title, description, tech, link, index } = Astro.props;
---

<a href={link} target="_blank" rel="noreferrer" class="group block border border-[var(--color-rule)] bg-[var(--color-paper-2)] p-6 rounded-[var(--radius-card)] hover:border-[var(--color-accent)] focus-visible:border-[var(--color-accent)] transition-colors duration-[var(--dur-short)] min-w-0">
  <div class="flex items-baseline justify-between gap-4 mb-3">
    <p class="tnum text-xs text-[var(--color-ink-2)]">{index}</p>
    <span aria-hidden="true" class="text-[var(--color-accent)]">↗</span>
  </div>

  <h3 class="font-bold text-[var(--color-ink)] text-[var(--text-lg)] tracking-tight mb-2 min-w-0 overflow-wrap-anywhere" style="font-family: var(--font-display); overflow-wrap: anywhere;">
    {title}
  </h3>

  <p class="text-[var(--color-ink-2)] text-sm mb-6 leading-[1.6] max-w-[65ch]">
    {description}
  </p>

  <ul class="tnum flex flex-wrap gap-2" aria-label="tech">
    {tech.map((t) => (
      <li class="text-xs px-2 py-1 border border-[var(--color-rule)] text-[var(--color-ink-2)] rounded-[var(--radius-card)] whitespace-nowrap">
        {t}
      </li>
    ))}
  </ul>
</a>
