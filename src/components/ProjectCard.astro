---
interface Props {
  title: string;
  description: string;
  tech: string[];
  link: string;
}

const { title, description, tech, link } = Astro.props;
---

<a href={link} target="_blank" class="block group relative border border-zinc-800 bg-zinc-900/50 p-6 hover:border-cyan-400/50 transition-colors">
  <div class="absolute top-0 right-0 p-4 opacity-0 group-hover:opacity-100 transition-opacity text-cyan-400">
    ↗
  </div>
  
  <h3 class="text-lg font-bold text-white mb-2 group-hover:text-cyan-400 transition-colors">
    {title}
  </h3>
  
  <p class="text-zinc-400 text-sm mb-6 leading-relaxed">
    {description}
  </p>
  
  <div class="flex flex-wrap gap-2">
    {tech.map((t) => (
      <span class="text-xs px-2 py-1 bg-zinc-800 text-zinc-300 border border-zinc-700">
        {t}
      </span>
    ))}
  </div>
</a>
