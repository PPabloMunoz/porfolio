---
interface SkillCategory {
  name: string;
  items: string[];
}

interface Props {
  introText: string;
  categories: SkillCategory[];
}

const { introText, categories } = Astro.props;
---

<div class="space-y-6">
  <div class="space-y-3">
    <p class="text-sm text-[var(--color-accent)]">$ skills</p>
    <h2 class="font-bold text-[var(--color-ink)] text-[var(--text-xl)] tracking-tight min-w-0" style="font-family: var(--font-display); overflow-wrap: anywhere;">skills</h2>
    <p class="text-sm text-[var(--color-ink-2)] max-w-[65ch] leading-[1.6]">
      {introText}
    </p>
  </div>

  <dl class="tnum border-t border-[var(--color-rule)]">
    {categories.map((category) => (
      <div class="grid gap-1 py-4 border-b border-[var(--color-rule)] md:grid-cols-[16ch_minmax(0,1fr)] md:gap-6">
        <dt class="text-xs uppercase tracking-[0.12em] text-[var(--color-accent)] font-bold">
          {category.name}
        </dt>
        <dd class="text-sm text-[var(--color-ink-2)] leading-relaxed min-w-0">
          {category.items.join(" · ")}
        </dd>
      </div>
    ))}
  </dl>
</div>
